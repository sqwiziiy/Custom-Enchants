{
	"schemaVersion": 1,
	"id": "custom-enchants",
	"version": "${version}",
	"name": "Mentalitys | Custom Enchantments",
	"description": "A configurable collection of gameplay enchantments for Minecraft 1.21.1 on Fabric.",
	"authors": [
		"mentality"
	],
	"license": "CC0-1.0",
	"icon": "assets/custom-enchants/icon.png",
	"contact": {
		"sources": "https://github.com/sqwiziiy/Custom-Enchants",
		"issues": "https://github.com/sqwiziiy/Custom-Enchants/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mentality.customenchants.CustomEnchantsMod"
		],
		"client": [
			"com.mentality.customenchants.CustomEnchantsClient"
		],
		"modmenu": [
			"com.mentality.customenchants.config.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": ">=0.116.15+1.21.1",
		"cloth-config": ">=15.0.140"
	},
	"suggests": {
		"modmenu": ">=11.0.4"
	},
	"mixins": [
		"custom-enchants.mixins.json",
		{
			"config": "custom-enchants.client.mixins.json",
			"environment": "client"
		}
	]
}
